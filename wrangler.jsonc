{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "bedtime-words",
  "main": "src/worker.js",
  "compatibility_date": "2026-10-06",
  "observability": {
    "enabled": true
  },
  // Static files are served directly; the Worker only runs for these paths.
  "assets": {
    "directory": "public",
    "binding": "ASSETS",
    "run_worker_first": ["/api/*", "/review/*", "/admin", "/admin/*"]
  },
  "routes": [
    { "pattern": "affirmations.buildwith.dad", "custom_domain": true }
  ],
  "d1_databases": [
    { "binding": "DB", "database_name": "bedtime-words", "database_id": "be4e4892-85a9-4a6f-a77c-d0c14b46d8c9", "migrations_dir": "migrations" }
  ],
  "send_email": [
    { "name": "MAILER" }
  ],
  // Daily: forget contacts 90 days after a decision, drop old rate-limit windows.
  "triggers": {
    "crons": ["17 13 * * *"]
  },
  // Secrets (wrangler secret put): TURNSTILE_SECRET, REVIEW_SECRET, RATE_SECRET,
  // MODERATOR_EMAIL, MAINTAINERS (comma-separated), ACCESS_TEAM_DOMAIN, ACCESS_AUD.
  "vars": {
    "COMMUNITY_ENABLED": "true",
    "TURNSTILE_SITE_KEY": "0x4AAAAAAFi3OCb0lqluOWQp",
    "MAIL_FROM": "bedtime@buildwith.dad"
  }
}
